# Production environment for docker compose / Coolify.
# Copy this file to .env next to docker-compose.yml and fill in the values.

# Generate with: php artisan key:generate --show
# Rotating this value makes stored provider credentials unreadable.
APP_KEY=
APP_URL=https://lafiel.example.com

DB_DATABASE=lafiel
DB_USERNAME=lafiel
DB_PASSWORD=

# Host port for the web role when not fronted by a proxy.
APP_PORT=8080
